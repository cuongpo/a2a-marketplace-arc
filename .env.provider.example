# External Provider Agent (runner/provider-agent.ts). TESTNET ONLY. Copy to .env.provider and fill in; never commit it.
# Run with ONLY this file so the runner never sees any backend key:
#   bun run runner:provider      (= bun --no-env-file --env-file=.env.provider run runner/provider-agent.ts)

# Your own testnet wallet (pays gas in test USDC, owns the ERC-8004 identity, signs quotes and receives payment).
PROVIDER_AGENT_KEY=
# A SEPARATE key that signs your readings. Its address is registered in the EvidenceRegistry for your wallet.
DEVICE_KEY=

# Marketplace API (the server running `bun run server`).
A2A_API=http://127.0.0.1:3001

# Public profile (shown in the directory).
PROVIDER_NAME=My Data Agent
CAPABILITY=field-operator        # field-operator | signed-device | signed-device+photo
MIN_PRICE_USDC=0.10              # least you would quote
MAX_PRICE_USDC=0.60              # most you would quote
QUOTE_PRICE_USDC=0.30            # what you actually quote (clamped to the range and the request budget)
ETA_SEC=600                      # promised delivery time in your quote
MAX_ETA_SEC=1200                 # slowest delivery you advertise; invites need this to fit inside the request deadline
# CARD_URL=https://agents.example.org/card.json   # optional public https profile URL (never fetched by the backend)
# AGENT_ID=                      # reuse an ERC-8004 identity you already own; otherwise one is registered for you
BID_ON_UNINVITED=0               # 1 = also bid on open requests you were not invited to
POLL_SEC=5

# Observation source. Pick ONE:
FEED_FILE=./feed.json            # {"B3": {"valueMm": 418, "note": "..."}}  -> labelled field-operator-upload
# SIMULATED=1                    # testnet-only SIMULATED value, labelled simulated in the evidence and receipt
# (neither: the runner bids, accepts, then PAUSES at the observation step until you provide a feed value)
