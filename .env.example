# FieldQuest environment (names only; never commit real values).
# Generate TESTNET-ONLY role keys into .env with:  bun run fq:keygen
# These keys are held by the backend process only. They are never sent to the browser.

FQ_NETWORK=testnet                # testnet | mainnet. Server-held keys are refused on mainnet (docs/MAINNET_RUNBOOK.md)
FQ_SERVER_PORT=3001               # backend port; Vite proxies /api to it
FQ_DATA_DIR=data                  # persisted agent state + content-addressed evidence
FQ_ENABLE_FIXTURE=1               # 1 = allow the SIMULATED sensor fixture (testnet only). 0 disables it
FQ_VAULT_DEPOSIT=3                # USDC the setup script deposits into the vault

FQ_OPERATOR_KEY=                  # demo operator (owns vault budget)
FQ_BUYER_AGENT_KEY=               # buyer agent executor
FQ_PROVIDER_KEY=                  # provider A wallet
FQ_SENSOR_KEY=                    # SIMULATED device key for provider A
FQ_PROVIDER2_KEY=                 # provider B wallet
FQ_SENSOR2_KEY=                   # SIMULATED device key for provider B
FQ_VERIFIER_KEY=                  # verifier agent wallet
FQ_ARBITER_KEY=                   # human arbiter demo key

# Optional. Unused by the deterministic verifier; reserved for an advisory-only model review (not implemented).
FQ_LLM_API_KEY=

# Provisioned by Arc Studio sandboxes (optional elsewhere): authenticated RPC proxy.
RPC_PROXY_BASE_URL=
RPC_PROXY_TOKEN=
RPC_PROXY_CHAINS=
